  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "version": "node scripts/set-version.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{ts,json}\" \".github/**/*.yml\" \"index.html\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{ts,json}\" \".github/**/*.yml\" \"index.html\""
  },
  "dependencies": {
    "@lucide/vue": "^1.40.0",
